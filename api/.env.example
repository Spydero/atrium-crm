DATABASE_URL="postgresql://USER@localhost:5432/atrium?schema=public"
BETTER_AUTH_SECRET="generate-with-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:4000"
CLIENT_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3001"
PORT=4000
# External API origin used for uploaded image links (HTTPS in production).
PUBLIC_API_URL="http://localhost:4000"

# Stock photo picker uses a built-in local catalog (no third-party API keys).
TESTING_ENABLED=true

# Enables sample enquiry buttons and their API. Use on a demo deployment only.
DEMO_MODE=false
