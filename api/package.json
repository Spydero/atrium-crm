{
  "name": "atrium-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:new": "prisma migrate dev --create-only --name",
    "db:deploy": "tsx scripts/db-tools.ts deploy",
    "db:status": "tsx scripts/db-tools.ts status",
    "db:history": "tsx scripts/db-tools.ts history",
    "db:push": "echo 'db push is disabled: it changes the database without a record. Use npm run db:new -- <name> then npm run db:deploy (see prisma/CHANGELOG.md)' && exit 1",
    "db:seed": "tsx src/seed.ts",
    "db:seed:demo": "tsx src/seed.ts && tsx scripts/seed-history.ts",
    "db:generate": "prisma generate",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/leadTools.test.ts tests/guideTools.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.14",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
